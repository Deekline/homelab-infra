{
  "uid": "authelia",
  "title": "Authelia",
  "tags": ["edge", "authelia", "auth"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "description": "Authelia authentication metrics (VictoriaMetrics, job=authelia-edge) and raw logs (VictoriaLogs, via Vector journald).",
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Log level",
        "type": "custom",
        "query": "trace,debug,info,warn,error,fatal",
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "current": { "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "search",
        "label": "Filter (e.g. username:bob or remote_ip:1.2.3.4)",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Failed 1FA logins (range)",
      "description": "authelia_authn{success=\"false\"} — password/file-backend authentication failures.",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(authelia_authn{job=\"authelia-edge\",success=\"false\"}[$__range])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 6 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed 2FA attempts (range)",
      "description": "authelia_authn_second_factor{success=\"false\"} — TOTP/WebAuthn/Duo failures.",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(authelia_authn_second_factor{job=\"authelia-edge\",success=\"false\"}[$__range])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 6 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Regulation bans (range)",
      "description": "authelia_authn{banned=\"true\"} or authelia_authn_second_factor{banned=\"true\"} — Authelia's own brute-force protection (max_retries/find_time/ban_time in configuration.yml) kicked in.",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(authelia_authn{job=\"authelia-edge\",banned=\"true\"}[$__range])) or vector(0)) + (sum(increase(authelia_authn_second_factor{job=\"authelia-edge\",banned=\"true\"}[$__range])) or vector(0))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "1FA login attempts by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (success) (increase(authelia_authn{job=\"authelia-edge\"}[$__rate_interval]))",
          "legendFormat": "{{success}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "false" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "true" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "2FA attempts by type & outcome",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type, success) (increase(authelia_authn_second_factor{job=\"authelia-edge\"}[$__rate_interval]))",
          "legendFormat": "{{type}} - {{success}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Regulation bans over time",
      "description": "A rising count here means Authelia itself started rejecting an already-banned client, independent of the raw failure rate above.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(authelia_authn{job=\"authelia-edge\",banned=\"true\"}[$__rate_interval]))",
          "legendFormat": "1FA banned"
        },
        {
          "refId": "B",
          "expr": "sum(increase(authelia_authn_second_factor{job=\"authelia-edge\",banned=\"true\"}[$__rate_interval]))",
          "legendFormat": "2FA banned"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*banned" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Authelia logs",
      "description": "Raw Authelia log lines (service name starts with authelia-), parsed at query time with unpack_logfmt. Use the Filter box for e.g. username:bob or remote_ip:1.2.3.4 — field availability depends on what Authelia puts in that particular log line.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code",
          "expr": "service:~\"^authelia\" | unpack_logfmt | filter level:in($level) $search",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
