      "options": {
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Namespace"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum by (namespace) (kube_pod_status_phase{phase=\"Running\"})",
          "instant": true,
          "legendFormat": "{{namespace}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum by (namespace) (kube_pod_status_phase{phase=\"Pending\"})",
          "instant": true,
          "legendFormat": "{{namespace}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum by (namespace) (kube_pod_status_phase{phase=\"Failed\"})",
          "instant": true,
          "legendFormat": "{{namespace}}",
          "refId": "C"
        }
      ],
      "title": "Pod Status by Namespace",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Running",
              "Value #B": "Pending",
              "Value #C": "Failed",
              "namespace": "Namespace"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "fieldConfig": {
        "defaults": {
          "max": 1,
